# ==============================================================================
# CRM OS — Environment Configuration Template
# Copy this file to .env or .env.local and populate the values for your setup.
# ==============================================================================

# ─── Application & Server ─────────────────────────────────────────────────────
# Environment mode: development | production | test
NODE_ENV=development

# Server port for the custom Next.js + Socket.io server (default: 3000)
PORT=3000

# Canonical base URL of the application
# For local development: http://localhost:3000
# For production: https://crm.yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# ─── Database (MongoDB) ───────────────────────────────────────────────────────
# MongoDB connection URI with database name and authentication credentials.
# Local Docker instance:
MONGODB_URI=mongodb://admin:password@localhost:27017/crm?authSource=admin
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/crm?retryWrites=true&w=majority

# ─── Authentication (NextAuth.js) ─────────────────────────────────────────────
# Secret key used to sign and encrypt JWT session tokens and cookies.
# Generate a strong 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-character-secret-key-here

# ─── AI Intelligence Engine ───────────────────────────────────────────────────
# Active provider choice: gemini (default) | groq | fallback
AI_PROVIDER=gemini

# Google Gemini API (Get key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API (Get key from https://console.groq.com/keys)
# Ultra-fast open-weight LLM inference with free tier available
GROQ_API_KEY=your_groq_api_key_here
# Groq model identifier (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Email Delivery (Resend) ──────────────────────────────────────────────────
# API key from Resend (Get key from https://resend.com)
# If omitted or left empty, emails are logged to the console instead of dispatched.
RESEND_API_KEY=your_resend_api_key_here

# Sender email address and name. Must match a verified domain in your Resend account.
# For local testing / sandbox before domain verification, use: onboarding@resend.dev
EMAIL_FROM=CRM OS <onboarding@resend.dev>
# Production example:
# EMAIL_FROM=CRM OS <notifications@yourdomain.com>